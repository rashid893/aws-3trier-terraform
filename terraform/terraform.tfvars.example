# ==============================================================================
# terraform.tfvars — the only file you need to edit
#
# Copy this to terraform.tfvars and fill in your values.
# Environment-specific sizing (instance types, ASG counts, etc.) is handled
# automatically by terraform.workspace — see environments.tf.
# ==============================================================================

# SSH key pair name (must exist in your AWS account)
key_name = "aws-3tier-dev"

# RDS credentials — set password via env var for safety:
#   export TF_VAR_db_password="YourSecurePassword123!"
db_username = "dbadmin"

# DNS (optional — only used when workspace = prod)
# domain_name = "example.com"
